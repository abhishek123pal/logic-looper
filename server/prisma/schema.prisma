datasource db {
  provider = "postgresql"
 
}

generator client {
  provider = "prisma-client-js"
}
model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  streak       Int      @default(0)
  totalPoints  Int      @default(0)
  createdAt    DateTime @default(now())

  scores       Score[]
}

model Score {
  id        String   @id @default(cuid())
  userId    String
  date      String
  score     Int
  time      Int

  user User @relation(fields: [userId], references: [id])

  @@index([date])
}

model UserStats {
  id            String @id @default(cuid())
  userId        String @unique
  puzzlesSolved Int
  avgTime       Float
}
